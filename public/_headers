# Never cache the shell or service worker: users must get updates immediately.
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache

# Hashed build assets are immutable.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Icons and manifest change rarely; revalidate each time.
/logo192.png
  Cache-Control: no-cache
/logo512.png
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache
