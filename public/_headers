# Never cache the app HTML or service worker: users must get updates immediately.
# Cloudflare Pages serves the app HTML for client routes (no 404.html = SPA fallback).
/
  Cache-Control: no-cache
/app
  Cache-Control: no-cache
/how-it-works
  Cache-Control: no-cache
/privacy
  Cache-Control: no-cache
/faq
  Cache-Control: no-cache
/about
  Cache-Control: no-cache
/storage-check
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache

# Hashed build assets are immutable.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Install assets change rarely; revalidate each time.
/manifest.json
  Cache-Control: no-cache
/icon-*
  Cache-Control: no-cache
/screenshots/*
  Cache-Control: no-cache
